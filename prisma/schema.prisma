// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  name         String?
  email        String   @unique
  passwordHash String
  profileJson  Json?
  resumeUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  JobMatches   JobMatch[] // relation to JobMatch (one-to-many)
  Applications Application[] // relation to Application (one-to-many)
}

model Job {
  id           String    @id @default(uuid())
  source       String
  externalId   String?
  title        String
  company      String
  location     String?
  description  String    @db.Text
  url          String
  rawPayload   Json?
  scrapedAt    DateTime  @default(now())
  normalizedAt DateTime?

  JobMatches   JobMatch[] // relation to JobMatch (one-to-many)
  Applications Application[] // relation to Application (one-to-many)
}

model JobMatch {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  score     Float
  reason    Json?
  createdAt DateTime @default(now())

  // Relation fields that point to User and Job (required)
  user User @relation(fields: [userId], references: [id])
  job  Job  @relation(fields: [jobId], references: [id])

  @@unique([userId, jobId])
}

model Application {
  id            String   @id @default(uuid())
  userId        String
  jobId         String
  status        String
  applyResult   Json?
  screenshotUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relation fields back to User and Job
  user User @relation(fields: [userId], references: [id])
  job  Job  @relation(fields: [jobId], references: [id])
}
